  "candidates": [
    {
      "id": "summoner-defender",
      "name": "四捍卫召唤：阿兹尔＋巨喙鸟妈妈",
      "hypothesis": "利用召唤输出与四捍卫前排延长有效攻击时间。阿兹尔与巨喙鸟妈妈得到18.2增强，但这不是18.2b新增增强；热修后的机会是高人口体系经济成本回升后的相对空间。两者伤害类型互补，不能据此推断已克制旧十套。",
      "positionReason": "拉莫斯独占前排中央优先接敌；慎、奥恩分担两翼。两名装备输出分居后排两侧，降低同吃直线技能的风险；无装备厄斐琉斯用于凑二速射并在右侧提供额外攻击目标。",
      "route6": "拉莫斯、慎、奥恩、阿兹尔、巨喙鸟妈妈、约里克；先用三召唤和捍卫过渡，装备只临时寄放。",
      "route7": "加入莉莉娅形成四捍卫；7级只在血量允许且阿兹尔/拉莫斯有较多对子时慢搜，不能把双三星视为必得。",
      "route8": "约里克换婕拉，加入厄斐琉斯与鸟妈妈形成二速射；主副C仍仅阿兹尔与鸟妈妈。",
      "economy": "双三费核心的两星/三星做完整2×2四分支。两核心从两星到三星额外购卡至少36金币，尚未计刷新；鸟妈妈始终两星，避免额外追三。三张四费两星也需要资金。",
      "failureModes": [
        "前排未撑过第二轮召唤",
        "召唤物伤害归属或出生时间错误",
        "两名输出起步慢、D5不足",
        "双三费追三导致上8与四费二星延迟"
      ],
